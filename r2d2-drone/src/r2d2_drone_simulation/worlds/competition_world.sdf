                        <ambient>0.75 0.35 0.05 1</ambient>
                        <diffuse>0.90 0.50 0.10 1</diffuse>
                        <specular>0.02 0.02 0.02 1</specular>
                    </material>
                    <transparency>0.45</transparency>
                </visual>
                <pose>0 1.75 1.5 0 0 0</pose>
            </link>
            <!-- Right Wall -->
            <link name="right_wall">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>10 0.10 3</size>
                        </box>
