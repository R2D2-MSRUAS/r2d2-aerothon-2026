<?xml version="1.0" ?>
<sdf version="1.10">

    <world name="competition_world">

        <!-- Physics System -->
        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>
        <!-- User Commands -->
        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>
        <!-- Render Scene -->
        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
        <!-- Sensor Systems -->
        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
        
        <!-- Physics Settings -->
        <physics name="default_physics" type="ignored">
            <!-- Simulation timestep (1000 Hz) -->
            <max_step_size>0.001</max_step_size>
            <!-- Real-time speed -->
            <real_time_factor>1.0</real_time_factor>
            <!-- Update rate -->
            <real_time_update_rate>1000</real_time_update_rate>
        </physics>
        <!-- Gravity -->
        <gravity>0 0 -9.81</gravity>
        <!-- Sun -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 50 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- ========================================================= -->
        <!-- COMPETITION CEILING                                       -->
        <!-- ========================================================= -->
        <model name="competition_ceiling">
            <static>true</static>
            <link name="link">
                <!-- Collision -->
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>60 30 0.2</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>60 30 0.2</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.35 0.35 0.35 0.30</ambient>
                        <diffuse>0.45 0.45 0.45 0.30</diffuse>
                        <specular>0.05 0.05 0.05 0.10</specular>
                    </material>
                    <transparency>0.30</transparency>
                </visual>
            </link>
            <pose>0 0 10 0 0 0</pose>
        </model>
        <!-- ========================================================= -->
        <!-- COMPETITION BACK WALL                                     -->
        <!-- ========================================================= -->
        <model name="competition_back_wall">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 30 10</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 30 10</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.35 0.35 0.35 0.45</ambient>
                        <diffuse>0.45 0.45 0.45 0.45</diffuse>
                        <specular>0.05 0.05 0.05 0.2</specular>
                    </material>
                    <transparency>0.10</transparency>
                </visual>
            </link>
            <pose>-30 0 5 0 0 0</pose>
        </model>
        <!-- ========================================================= -->
        <!-- COMPETITION FRONT WALL                                    -->
        <!-- ========================================================= -->
        <model name="competition_front_wall">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 30 10</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 30 10</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.35 0.35 0.35 0.45</ambient>
                        <diffuse>0.45 0.45 0.45 0.45</diffuse>
                        <specular>0.05 0.05 0.05 0.2</specular>
                    </material>
                    <transparency>0.10</transparency>
                </visual>
            </link>
            <pose>30 0 5 0 0 0</pose>
        </model>
        <!-- ========================================================= -->
        <!-- COMPETITION LEFT WALL                                     -->
        <!-- ========================================================= -->
        <model name="competition_left_wall">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>60 0.2 10</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>60 0.2 10</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.35 0.35 0.35 0.45</ambient>
                        <diffuse>0.45 0.45 0.45 0.45</diffuse>
                        <specular>0.05 0.05 0.05 0.2</specular>
                    </material>
                    <transparency>0.25</transparency>
                </visual>
            </link>
            <!-- x = -30 to +30 -->
            <pose>0 15 5 0 0 0</pose>
        </model>
        <!-- ========================================================= -->
        <!-- COMPETITION RIGHT WALL                                    -->
        <!-- ========================================================= -->
        <model name="competition_right_wall">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>60 0.2 10</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>60 0.2 10</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.35 0.35 0.35 0.45</ambient>
                        <diffuse>0.45 0.45 0.45 0.45</diffuse>
                        <specular>0.05 0.05 0.05 0.2</specular>
                    </material>
                    <transparency>0.10</transparency>
                </visual>
            </link>
            <!-- x = -30 to +30 -->
            <pose>0 -15 5 0 0 0</pose>
        </model>
        <!-- ========================================================= -->
        <!-- COMPETITION FLOOR                                         -->
        <!-- ========================================================= -->
        <model name="competition_floor">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>60 30 0.1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>60 30 0.1</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1.0 1.0 1.0 1</ambient>
                        <diffuse>1.0 1.0 1.0 1</diffuse>
                        <specular>0.0 0.0 0.0 1</specular>
                    </material>
                </visual>
            </link>
            <pose>0 0 -0.05 0 0 0</pose>
        </model>

        <!-- ========================= -->
        <!-- TAKEOFF FLOOR             -->
        <!-- ========================= -->
        <model name="takeoff_floor">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>4 8 0.12</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>4 8 0.12</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.15 0.35 0.75 1</ambient>
                        <diffuse>0.20 0.40 0.85 1</diffuse>
                        <specular>0.08 0.08 0.08 1</specular>
                    </material>
                </visual>
            </link>
            <pose>-28 0 0.06 0 0 0</pose>
        </model>

        <!-- ========================= -->
        <!-- RED ZONE                  -->
        <!-- ========================= -->
        <model name="red_zone">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>12 8 0.02</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>12 8 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.70 0.10 0.10 1</ambient>
                        <diffuse>0.90 0.15 0.15 1</diffuse>
                        <specular>0.05 0.05 0.05 1</specular>
                    </material>
                </visual>
            </link>
            <pose>15 0 0.01 0 0 0</pose>
        </model>

        <!-- ========================= -->
        <!-- FORWARD CORRIDOR          -->
        <!-- ========================= -->
        <model name="forward_corridor">
            <static>true</static>
            <!-- Left Wall -->
            <link name="left_wall">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>10 0.10 3</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>10 0.10 3</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.05 0.55 0.15 1</ambient>
                        <diffuse>0.10 0.70 0.20 1</diffuse>
                        <specular>0.02 0.02 0.02 1</specular>
                    </material>
                    <transparency>0.45</transparency>
                </visual>
                <pose>0 1.75 1.5 0 0 0</pose>
            </link>
            <!-- Right Wall -->
            <link name="right_wall">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>10 0.10 3</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>10 0.10 3</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.05 0.55 0.15 1</ambient>
                        <diffuse>0.10 0.70 0.20 1</diffuse>
                        <specular>0.02 0.02 0.02 1</specular>
                    </material>
                    <transparency>0.45</transparency>
                </visual>
                <pose>0 -1.75 1.5 0 0 0</pose>
            </link>
            <!-- Roof -->
            <link name="roof">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>10 3.5 0.10</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>10 3.5 0.10</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.05 0.55 0.15 1</ambient>
                        <diffuse>0.10 0.70 0.20 1</diffuse>
                        <specular>0.02 0.02 0.02 1</specular>
                    </material>
                    <transparency>0.45</transparency>
                </visual>
                <pose>0 0 3.05 0 0 0</pose>
            </link>
            <!-- Floor -->
            <link name="floor">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>10 3.5 0.02</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>10 3.5 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.05 0.55 0.15 1</ambient>
                        <diffuse>0.10 0.70 0.20 1</diffuse>
                        <specular>0.02 0.02 0.02 1</specular>
                    </material>
                </visual>
            </link>
            <pose>-15 3.75 0 0 0 0</pose>
        </model>

        <!-- ========================= -->
        <!-- RETURN CORRIDOR           -->
        <!-- ========================= -->
        <model name="return_corridor">
